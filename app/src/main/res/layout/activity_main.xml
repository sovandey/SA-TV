<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080D16">
    <LinearLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="18dp" android:paddingBottom="18dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/imageLogo" android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/sa_tv_logo" android:contentDescription="SA TV logo" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SA TV" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE TELEVISION" android:textColor="#9AA8BA" android:textSize="10sp" android:letterSpacing="0.16" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonFullScreen" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Full screen" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="14dp" app:backgroundTint="#202B3A" app:icon="@android:drawable/ic_menu_view" app:iconTint="#FFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonRefresh" android:layout_width="48dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:minWidth="0dp" android:padding="0dp" android:text="↻" android:textSize="23sp" android:textColor="#FFFFFF" app:cornerRadius="14dp" app:backgroundTint="#E53935" />
    </LinearLayout>
    <TextView android:id="@+id/sectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:text="চ্যানেল দেখুন" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/sectionSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="3dp" android:text="আপনার পছন্দের লাইভ চ্যানেল খুঁজে নিন" android:textColor="#8D9AAF" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/sectionTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/searchContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="18dp" app:boxBackgroundColor="#151F2D" app:boxBackgroundMode="filled" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:startIconDrawable="@android:drawable/ic_menu_search" app:startIconTint="#9AA8BA" app:hintEnabled="false" app:layout_constraintTop_toBottomOf="@id/sectionSubtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/editSearch" android:layout_width="match_parent" android:layout_height="54dp" android:hint="চ্যানেল বা ক্যাটাগরি খুঁজুন" android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#8492A5" android:paddingTop="0dp" android:paddingBottom="0dp" />
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerChannels" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="10dp" android:clipToPadding="false" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="16dp" app:layout_constraintTop_toBottomOf="@id/searchContainer" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/textEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="কোনো চ্যানেল পাওয়া যায়নি" android:textColor="#AAB6C6" android:textSize="15sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>