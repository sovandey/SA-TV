<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardBackgroundColor="#151F2D" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:strokeColor="#263448" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <TextView android:id="@+id/textChannelNumber" android:layout_width="42dp" android:layout_height="wrap_content" android:text="001" android:gravity="center" android:textColor="#9AA8BA" android:textSize="13sp" android:textStyle="bold" />
        <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:background="#263448">
            <ImageView android:id="@+id/imageChannelLogo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:scaleType="fitCenter" android:visibility="gone" />
            <TextView android:id="@+id/textLogoFallback" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="A" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
            <TextView android:id="@+id/textChannelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/textCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#91A0B4" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE" android:textColor="#FF7777" android:textSize="10sp" android:textStyle="bold" android:background="#332B171B" android:paddingHorizontal="9dp" android:paddingVertical="5dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
